{
  "name": "oss-maintainer-ai",
  "version": "1.0.0",
  "description": "Production-grade Open Source AI Maintainer designed to automate workflows and assist open source project maintenance.",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkraider01/OSS-Maintainer-AI.git"
  },
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format:check": "prettier --check \"src/**/*.ts\" \"docs/**/*.md\"",
    "format:write": "prettier --write \"src/**/*.ts\" \"docs/**/*.md\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "docs/**/*.md": [
      "prettier --write"
    ]
  },
  "keywords": [
    "ai",
    "maintainer",
    "caspian",
    "github-actions",
    "automation",
    "agents"
  ],
  "author": "darkraider01 <darkraider01@users.noreply.github.com>",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "caspian-sdk": "^0.6.1",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
