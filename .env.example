# OSS-Maintainer-AI Environment Config

# --- Caspian SDK Credentials ---
# `caspian init` generates the key. COMM_API_KEY / COMM_BASE_URL still work (legacy names).
CASPIAN_API_KEY=your_caspian_api_key_here
CASPIAN_BASE_URL=https://api.trycaspianai.com
CASPIAN_TIMEOUT_SECONDS=30

# --- Ingress ---
# poll    = long-lived process running the SDK event loop (no public URL needed)
# webhook = HTTP endpoint the gateway pushes deliveries to (serverless friendly)
CASPIAN_INGRESS_MODE=poll
CASPIAN_WEBHOOK_PATH=/webhooks/caspian
# Required when CASPIAN_INGRESS_MODE=webhook. Same secret passed to setWebhook().
CASPIAN_WEBHOOK_SECRET=
# Public URL registered with the gateway by `pnpm caspian:connect-github`.
CASPIAN_WEBHOOK_URL=
PORT=3000

# Comma-separated channels accepted from Caspian. GitHub is the first integration.
CASPIAN_ENABLED_CHANNELS=github

# --- GitHub channel ---
# Leave the four App variables empty to use Caspian's shared GitHub App (one-click install).
# Set all four to bring your own App. Escaped newlines in the private key are handled.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# mentions = only comments that @-mention the agent; all = every comment
GITHUB_RECEIVE_MODE=mentions

# Optional PAT for direct GitHub REST calls (not used by Caspian ingress).
GITHUB_TOKEN=your_github_pat_here

# --- Logger ---
LOG_LEVEL=info

# --- Agent Runtime & Demo Settings ---
# Set to false to connect real LLM providers in production
DEMO_MODE=true
# Support OpenAI, Gemini, Claude, or mock
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
