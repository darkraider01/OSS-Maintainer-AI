# OSS-Maintainer-AI Environment Config

# --- Caspian SDK Credentials ---
# `caspian init` generates the key. COMM_API_KEY / COMM_BASE_URL still work (legacy names).
CASPIAN_API_KEY=your_caspian_api_key_here
CASPIAN_BASE_URL=https://api.trycaspianai.com
CASPIAN_TIMEOUT_SECONDS=30

# --- Ingress ---
# poll    = long-lived process running the SDK event loop (no public URL needed)
# webhook = HTTP endpoint the gateway pushes deliveries to (serverless friendly)
CASPIAN_INGRESS_MODE=poll
CASPIAN_WEBHOOK_PATH=/webhooks/caspian
# Required when CASPIAN_INGRESS_MODE=webhook. Same secret passed to setWebhook().
CASPIAN_WEBHOOK_SECRET=
# Public URL registered with the gateway by `pnpm caspian:connect-github`.
CASPIAN_WEBHOOK_URL=
PORT=3000

# Comma-separated channels accepted from Caspian. GitHub is the first integration.
CASPIAN_ENABLED_CHANNELS=github

# --- GitHub channel (Caspian bring-your-own-App provisioning) ---
# Leave the four App variables empty to use Caspian's shared GitHub App (one-click install).
# Set all four to bring your own App. Escaped newlines in the private key are handled.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# mentions = only comments that @-mention the agent; all = every comment
GITHUB_RECEIVE_MODE=mentions

# Optional PAT for direct GitHub REST calls (not used by Caspian ingress).
GITHUB_TOKEN=your_github_pat_here

# --- GitHub direct channel (bypasses Caspian; GitHub is not a Caspian channel today) ---
# Set to true to enable a real GitHub webhook endpoint + GitHub App egress.
# Reuses GITHUB_APP_ID / GITHUB_APP_SLUG / GITHUB_PRIVATE_KEY / GITHUB_WEBHOOK_SECRET above.
# Everything else (Slack/Discord/rest of the app) starts normally when this is left false.
GITHUB_ENABLED=false
# The installation ID from installing the App on a repository/org.
GITHUB_INSTALLATION_ID=
# Path this app listens on for GitHub webhook deliveries.
GITHUB_WEBHOOK_PATH=/webhooks/github

# --- Account-linking dashboard (ties one human's GitHub/Slack/Discord identities together) ---
# Set to true to enable the dashboard. Shares the webhook HTTP server/port.
# Everything else starts normally when this is left false.
AUTH_ENABLED=false
# Public base URL (no trailing slash) used to build each provider's OAuth redirect_uri,
# e.g. your tunnel URL. Each provider's app must have <AUTH_BASE_URL>/auth/<provider>/callback
# registered as an allowed redirect URI.
AUTH_BASE_URL=
# Reuses the GitHub App's own built-in OAuth client (App settings -> General -> Client ID/secret) -
# not the App ID/private key used for webhook/API auth above.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# From a separate, OAuth-only Slack App (api.slack.com/apps) with the "identity.basic"
# User Token Scope added under OAuth & Permissions.
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
# From a Discord Application (discord.com/developers/applications), OAuth2 tab.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
# owner/repo the dashboard checks for a linked GitHub account's issue/PR counts.
# Optional - the dashboard still shows message counts without it.
GITHUB_STATS_REPO=

# --- Logger ---
LOG_LEVEL=info

# --- Agent Runtime & Demo Settings ---
# Set to false to connect real LLM providers in production
DEMO_MODE=true
# Support OpenAI, Gemini, Claude, or mock
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Embedding model used by `pnpm run ingest:docs` (issue #9). Only used in live mode.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
